# ========================================
# .env файл - скопируйте в .env и заполните!
# ========================================

# ОСНОВНОЙ СЕКРЕТ DJANGO (обязательно!)
# Зачем: Шифрование сессий, токенов, CSRF.
# Как: cd backend && python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Вставьте 50+ символов строку сюда:
SECRET_KEY=django-insecure-change-this-in-prod-with-generated-key

# ОТЛАДКА (локально True, прод False)
# Зачем: Показ ошибок в браузере, debug-toolbar.
DEBUG=True

# РАЗРЕШЕННЫЕ ХОСТЫ
# Зачем: Безопасность, только эти домены обслуживают.
# Локально: localhost,127.0.0.1
# Прод: yourdomain.com,api.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# CORS - откуда разрешены запросы (frontend)
# Зачем: Frontend на другом порту/домене.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourfrontend.com

# БАЗА ДАННЫХ
# Зачем: SQLite локально, Postgres прод.
# Формат: sqlite:///./db.sqlite3 или postgresql://user:pass@host:port/db
DATABASE_URL=sqlite:///./db.sqlite3

# REDIS для WebSocket (Channels prod)
# Зачем: Масштабируемые WS группы.
# Локально: redis://localhost:6379/0
# Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# SENTRY (мониторинг ошибок, optional)
# Зачем: Логи ошибок в prod.
# Получить: sentry.io -> project DSN
SENTRY_DSN=

# JWT ТОКЕНЫ (auth)
# Зачем: Время жизни токенов.
SIMPLE_JWT_ACCESS_TOKEN_LIFETIME=3600  # сек, 1ч
SIMPLE_JWT_REFRESH_TOKEN_LIFETIME=86400 # 1 день

# EMAIL (регистрация/сброс пароля)
# Зачем: Отправка писем.
# Gmail: app password (2FA)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password

# ПРОД БЕЗОПАСНОСТЬ (за прокси Nginx)
SECURE_SSL_REDIRECT=False  # True if HTTPS
SECURE_PROXY_SSL_HEADER=('HTTP_X_FORWARDED_PROTO', 'https')
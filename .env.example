# Copy to .env in the repository root. Never commit the real file.
SECRET_KEY=replace-with-at-least-50-random-characters
DEBUG=False
ALLOWED_HOSTS=gofaraway.mooo.com,localhost
APP_BASE_PATH=/lra26
APP_PUBLIC_URL=https://gofaraway.mooo.com/lra26/
CORS_ALLOWED_ORIGINS=https://gofaraway.mooo.com
CSRF_TRUSTED_ORIGINS=https://gofaraway.mooo.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO
TRUSTED_PROXY_COUNT=2

POSTGRES_DB=lra26
POSTGRES_USER=lra26
POSTGRES_PASSWORD=replace-with-a-long-random-password
LRA26_PORT=8088

# Create the bot with @BotFather.
TELEGRAM_BOT_TOKEN=

# Secret from the VK Mini App settings.
VK_APP_SECRET=

# Optional error monitoring. PII sending is disabled in settings.
SENTRY_DSN=
